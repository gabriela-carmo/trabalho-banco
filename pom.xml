<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.unicesumar</groupId>
    <artifactId>banco-concorrente</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>Sistema Bancário com Transações Concorrentes</name>

    <properties>
        <!-- Java 17: dá pra usar record, que a gente usa em Transacao e Cliente -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Classe principal PADRÃO do exec:java. Como é uma propriedade (e não uma
             configuração fixa do plugin), dá pra trocar na linha de comando com
             -Dexec.mainClass=... (é isso que o demo da race condition faz). -->
        <exec.mainClass>br.unicesumar.banco.app.Main</exec.mainClass>
    </properties>

    <dependencies>
        <!-- Driver JDBC do MySQL: só é necessário em tempo de execução -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.4.0</version>
            <scope>runtime</scope>
        </dependency>

        <!-- JUnit 5 para os testes unitários -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Roda os testes com "mvn test" -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <!-- Atalho pra rodar classes com main: "mvn compile exec:java" -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
            </plugin>
        </plugins>
    </build>
</project>
